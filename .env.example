# =============================================================
# iVANBAN - Environment Configuration
# Copy this file to .env.local and fill in your actual values
# =============================================================

# Supabase Database Configuration
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT
DB_PASSWORD=YOUR_PASSWORD

# Supabase Project API URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JWT Secret for User Sessions (generate a random 64-char hex string)
JWT_SECRET=your_jwt_secret_here

# NVIDIA NIM / Build API Configuration
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Google Gemini API Keys Pool (comma-separated)
LLM_API_KEYS=key1,key2
GEMINI_API_KEY=your_gemini_key_here
